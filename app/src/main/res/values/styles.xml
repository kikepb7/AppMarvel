<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- GENERAL -->
    <!-- White background -->
    <style name="background_white" parent="@style/Base.Theme.AppMarvel">
        <item name="android:background">@color/white</item>
    </style>

    <!-- Loading view -->
    <style name="loading_view" parent="@style/Base.Theme.AppMarvel">
        <item name="android:layout_width">100dp</item>
        <item name="android:layout_height">100dp</item>
        <item name="android:background">@drawable/loading_icon</item>
        <item name="android:fontFamily">sans-serif-condensed-medium</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:gravity">center</item>
        <item name="android:text">@string/m_of_marvel</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">64sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <!--FINISHED-->

    <!-- activity_main.xml -->
    <style name="activity_main_fragment_container_view" parent="@style/Base.Theme.AppMarvel">
        <item name="defaultNavHost">true</item>
        <item name="android:background">@color/black</item>
        <item name="navGraph">@navigation/main_graph</item>
    </style>
    <!--Finished-->

    <!-- fragment_home.xml -->
    <style name="main_buttons" parent="@style/Base.Theme.AppMarvel">
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">16sp</item>
        <item name="foregroundButton">@drawable/marvel_button</item>
        <item name="android:width">200dp</item>
        <item name="android:height">50dp</item>
    </style>
    <!--Finished-->

    <!-- fragment_films_series.xml -->
    <style name="rv_film_serie" parent="@style/Base.Theme.AppMarvel">
        <item name="android:layout_margin">@dimen/margin_5dp</item>
        <item name="layoutManager">androidx.recyclerview.widget.GridLayoutManager</item>
        <item name="spanCount">2</item>
        <item name="android:paddingBottom">@dimen/margin_5dp</item>
    </style>

    <style name="orderby_button" parent="@style/Base.Theme.AppMarvel">
        <item name="android:layout_marginEnd">@dimen/margin_5dp</item>
        <item name="android:text">@string/orderby</item>
    </style>

    <style name="searchview_films_series" parent="@style/Base.Theme.AppMarvel">
        <item name="android:inputType">text</item>
        <item name="android:layout_marginStart">@dimen/margin_5dp</item>
        <item name="android:queryHint">@string/search</item>
    </style>
    <!--Finished-->

    <!-- item_films_series.xml -->
    <style name="item_film_serie_image" parent="@style/Base.Theme.AppMarvel">
        <item name="android:scaleType">centerCrop</item>
        <item name="ratio">1.5</item>
    </style>

    <style name="item_film_serie_title" parent="@style/Base.Theme.AppMarvel">
        <item name="android:background">@color/light_red</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/title_text_size_15sp</item>
        <item name="android:padding">@dimen/title_padding_3dp</item>
    </style>

    <style name="item_film_serie_fav_icon" parent="@style/Base.Theme.AppMarvel">
        <item name="android:layout_marginTop">@dimen/margin_5dp</item>
        <item name="android:layout_marginEnd">@dimen/margin_5dp</item>
        <item name="android:src">@drawable/ic_border_favorite_24dp</item>
        <item name="android:contentDescription">@string/fav_off</item>
    </style>
    <!--Finished-->

    <!-- item_details_films_series.xml -->
    <style name="detail_film_serie_image" parent="@style/Base.Theme.AppMarvel">
        <item name="android:scaleType">centerCrop</item>
    </style>

    <style name="detail_film_serie_name" parent="@style/Base.Theme.AppMarvel">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/text_size_detail_serie_name_20sp</item>
        <item name="android:background">@color/dark_red</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="detail_film_serie_description" parent="@style/Base.Theme.AppMarvel">
        <item name="android:layout_marginStart">@dimen/margin_16dp</item>
        <item name="android:layout_marginTop">@dimen/margin_16dp</item>
        <item name="android:layout_marginEnd">@dimen/margin_16dp</item>
        <item name="android:layout_marginBottom">@dimen/margin_16dp</item>
        <item name="android:textSize">@dimen/text_size_description_detail_18sp</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:lineSpacingExtra">@dimen/spacing_extra_description_detail_2dp</item>
    </style>
    <!--Finished-->

    <style name="item_superhero_txt" parent="@style/Base.Theme.AppMarvel">
        <item name="android:padding">@dimen/txt_item_superhero_paddin_8dp</item>
        <item name="android:textSize">@dimen/text_size_16sp</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="img_item_superhero" parent="@style/Base.Theme.AppMarvel">
        <item name="android:adjustViewBounds">true</item>
        <item name="android:scaleType">centerCrop</item>
    </style>

    <!-- FRAGMENT_COMIC -->

    <!-- Search Bar Comics -->
    <style name="txt_search_fragment_comic" parent="@style/Base.Theme.AppMarvel">
        <item name="android:layout_marginStart">@dimen/margin_5dp</item>
        <item name="android:hint">@string/search</item>
        <item name="android:inputType">text</item>
    </style>

    <!-- Back Arrow ImageButton -->
    <style name="back_arrow_imageButton">
        <item name="android:layout_marginStart">@dimen/logo_margin</item>
        <item name="android:layout_marginTop">@dimen/logo_margin</item>
        <item name="android:backgroundTint">@color/black</item>
        <item name="android:src">@drawable/back_arrow</item>
        <item name="android:contentDescription">@string/back_button</item>
    </style>

    <!-- Error ImageView -->
    <style name="error_imageView">
        <item name="android:layout_width">@dimen/logo_error_width</item>
        <item name="android:layout_height">@dimen/logo_error_height</item>
        <item name="android:src">@drawable/unauthorized_error_logo</item>
    </style>

    <!-- Error TextView -->
    <style name="error_textView">
        <item name="android:layout_marginTop">@dimen/logo_margin</item>
        <item name="android:textColor">@color/dark_red</item>
        <item name="android:textSize">@dimen/text_size_16sp</item>
    </style>

    <!-- Logo ImageView -->
    <style name="logo_imageView">
        <item name="android:layout_width">@dimen/logo_width</item>
        <item name="android:layout_height">@dimen/logo_height</item>
        <item name="android:layout_margin">@dimen/logo_margin</item>
        <item name="android:src">@drawable/marvel_comics_logo</item>
        <item name="android:contentDescription">@string/marvel_comics_logo</item>
    </style>

    <!-- Logo All Comics ImageView -->
    <style name="logo_all_comics_imageView">
        <item name="android:layout_width">@dimen/icon_width</item>
        <item name="android:layout_height">@dimen/icon_height</item>
        <item name="android:layout_marginStart">@dimen/icon_margin_start</item>
        <item name="android:layout_marginTop">@dimen/icon_margin_top</item>
        <item name="tint">@color/white</item>
        <item name="android:src">@drawable/ironman</item>
        <item name="android:contentDescription">@string/title_icon</item>
    </style>

    <!-- Logo Favorite Comics ImageView -->
    <style name="logo_favorite_comics_imageView">
        <item name="android:layout_width">@dimen/icon_width</item>
        <item name="android:layout_height">@dimen/icon_height</item>
        <item name="android:layout_marginStart">@dimen/icon_margin_start</item>
        <item name="android:layout_marginTop">@dimen/icon_margin_top</item>
        <item name="tint">@color/white</item>
        <item name="android:src">@drawable/ic_solid_heart</item>
        <item name="android:contentDescription">@string/title_icon</item>
    </style>

    <!-- Title All Comics TextView -->
    <style name="title_comics_textView">
        <item name="android:layout_marginStart">@dimen/text_margin_start</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/text_size_24sp</item>
        <item name="android:text">@string/all_comics_title</item>
    </style>

    <!-- Title All Comics TextView -->
    <style name="title_favorite_comics_textView">
        <item name="android:layout_marginStart">@dimen/text_margin_start</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/text_size_24sp</item>
        <item name="android:text">@string/favorite_comics_title</item>
    </style>


    <!-- Recycler All Comics -->
    <style name="all_comics_recycler">
        <item name="android:layout_marginTop">@dimen/recycler_margin_top</item>
    </style>

    <!-- Progress Bar -->
    <style name="progress_bar">
        <item name="android:indeterminateTint">@color/dark_red</item>
    </style>


    <!-- FRAGMENT_COMIC_DETAIL -->

    <!-- Toolbar -->

    <!-- Back Arrow ImageButton -->
    <style name="back_imageButton">
        <item name="android:paddingStart">@dimen/padding_start</item>
        <item name="android:paddingEnd">@dimen/padding_end</item>
        <item name="android:src">@drawable/back_arrow</item>
        <item name="tint">@color/black</item>
    </style>

    <!-- ToolBar Title -->
    <style name="toolbar_title">
        <item name="android:text">@string/app_name</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/toolbar_title</item>
    </style>

    <!-- ShapeableImageView -->
    <style name="RoundedShapeableImageView" parent="">
        <item name="cornerFamilyTopLeft">rounded</item>
        <item name="cornerFamilyTopRight">rounded</item>
        <item name="cornerSizeTopLeft">15%</item>
        <item name="cornerSizeTopRight">15%</item>
    </style>

    <!-- Error ImageView -->
    <style name="error_imageView_detail">
        <item name="android:layout_width">@dimen/logo_error_width</item>
        <item name="android:layout_height">@dimen/logo_error_height</item>
        <item name="android:src">@drawable/comic_detail_error</item>
        <item name="android:contentDescription">@string/logo_error</item>
    </style>

    <!-- Comic ImageView -->
    <style name="comic_imageView">
        <item name="android:layout_height">@dimen/ivComic_height</item>
    </style>

    <!-- Guideline -->
    <style name="guideline">
        <item name="android:layout_height">@dimen/guideline_height</item>
        <item name="layout_constraintGuide_begin">@dimen/guideline_begin</item>
    </style>

    <!-- Shapeable ImageView -->
    <style name="shapeable_imageView">
        <item name="android:layout_height">@dimen/shapeable_image_height</item>
        <item name="android:background">@color/dark_red</item>
        <item name="android:elevation">@dimen/shapeable_elevation</item>
    </style>

    <!-- Title textView -->
    <style name="title_text_view">
        <item name="android:layout_marginStart">@dimen/shapeable_title_description_horizontal_margin</item>
        <item name="android:layout_marginTop">@dimen/shapeable_title_description_margin_top</item>
        <item name="android:layout_marginEnd">@dimen/shapeable_title_description_horizontal_margin</item>
        <item name="android:elevation">@dimen/elevation</item>
        <item name="android:maxWidth">@dimen/shapeable_max_width</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/text_size_22sp</item>
    </style>

    <!-- ScrollView -->
    <style name="scroll">
        <item name="android:layout_height">@dimen/scroll_height</item>
        <item name="android:elevation">@dimen/elevation</item>
    </style>

    <!-- Description textView -->
    <style name="description_text_view">
        <item name="android:layout_marginStart">@dimen/shapeable_title_description_horizontal_margin</item>
        <item name="elevation">@dimen/elevation</item>
        <item name="android:textSize">@dimen/text_size_14sp</item>
        <item name="android:textColor">@color/black</item>
        <item name="layout_goneMarginEnd">@dimen/text_margin_end</item>
    </style>

    <!-- Comic pages -->
    <style name="pages_text_view">
        <item name="android:layout_margin">@dimen/text_margin</item>
        <item name="android:layout_marginEnd">@dimen/text_margin</item>
        <item name="android:layout_marginBottom">@dimen/text_margin</item>
        <item name="elevation">@dimen/elevation</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/text_size_18sp</item>
    </style>

    <!-- Favorite Button -->
    <style name="favorite_button">
        <item name="android:layout_width">@dimen/favorite_width_height</item>
        <item name="android:layout_height">@dimen/favorite_width_height</item>
        <item name="android:layout_marginTop">@dimen/favorite_margin</item>
        <item name="android:layout_marginEnd">@dimen/favorite_margin</item>
        <item name="android:elevation">@dimen/elevation</item>
        <item name="tint">@color/white</item>
    </style>

</resources>