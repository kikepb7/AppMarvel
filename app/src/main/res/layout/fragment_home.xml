<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background_image"
    tools:context=".view.HomeFragment">

    <FrameLayout
        android:id="@+id/frameLayout"
        android:layout_width="match_parent"
        android:layout_height="650dp"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal">

        <com.enriquepalmadev.appmarvel.view.components.MarvelButton
            android:id="@+id/buttonComics"
            style="@style/buttons"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_marginStart="0dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:text="@string/button_comics"
            app:buttonText="@string/button_comics" />

        <com.enriquepalmadev.appmarvel.view.components.MarvelButton
            android:id="@+id/buttonCharacters"
            style="@style/buttons"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:text="@string/button_characters"
            app:buttonText="@string/button_characters" />

        <com.enriquepalmadev.appmarvel.view.components.MarvelButton
            android:id="@+id/buttonFilmsAndSeries"
            style="@style/buttons"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_marginEnd="0dp"
            android:layout_marginBottom="20dp"
            android:layout_weight="1"
            android:text="@string/button_films_and_series"
            app:buttonText="@string/button_films_and_series" />
    </LinearLayout>

</RelativeLayout>