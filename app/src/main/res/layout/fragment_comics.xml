<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/comicsViewContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.view.ComicsFragment">

    <ImageView
        android:id="@+id/logoScreen"
        android:layout_width="128dp"
        android:layout_height="96dp"
        android:layout_margin="16dp"
        android:contentDescription="@string/marvel_comics_logo"
        android:src="@drawable/marvel_comics_logo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipGroupFilter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/logoScreen" />

    <ImageView
        android:id="@+id/ivLogoAllComics"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@+id/chipGroupFilter"
        app:layout_constraintStart_toStartOf="parent"
        android:src="@drawable/ironman"
        app:tint="@color/white" />


    <TextView
        android:id="@+id/tvComicList"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:text="TODOS LOS COMICS"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/ivLogoAllComics"
        app:layout_constraintStart_toEndOf="@+id/ivLogoAllComics"
        app:layout_constraintTop_toTopOf="@+id/ivLogoAllComics" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvComics"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvComicList" />

    <ImageView
        android:id="@+id/ivLogoFavoriteComics"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@+id/rvComics"
        app:layout_constraintStart_toStartOf="parent"
        android:src="@drawable/ic_solid_heart"
        app:tint="@color/white" />

    <TextView
        android:id="@+id/tvFavoriteComics"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:text="COMICS FAVORITOS"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/ivLogoFavoriteComics"
        app:layout_constraintStart_toEndOf="@+id/ivLogoFavoriteComics"
        app:layout_constraintTop_toTopOf="@+id/ivLogoFavoriteComics" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvFavoriteComics"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvFavoriteComics" />


</androidx.constraintlayout.widget.ConstraintLayout>