<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/background_white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="@dimen/dimen_0dp"
        android:layout_height="@dimen/dimen_0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/detailImageFilmsSeries"
                style="@style/detail_film_serie_image"
                android:layout_width="@dimen/dimen_0dp"
                android:layout_height="@dimen/layout_height_image_details_series_250dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:src="@tools:sample/backgrounds/scenic"/>

            <LinearLayout
                android:layout_width="@dimen/dimen_0dp"
                android:layout_height="?attr/actionBarSize"
                app:layout_constraintBottom_toBottomOf="@id/detailImageFilmsSeries"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent">

                <TextView
                    android:id="@+id/detailFimsSeriesName"
                    style="@style/detail_film_serie_name"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    tools:text="Name"/>

            </LinearLayout>

            <TextView
                android:id="@+id/detailFimsSeriesDescription"
                style="@style/detail_film_serie_description"
                android:layout_width="@dimen/dimen_0dp"
                android:layout_height="wrap_content"
                tools:text="@tools:sample/lorem/random"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/detailImageFilmsSeries"/>

            <TextView
                android:id="@+id/detailFimsSeriesStarYear"
                style="@style/detail_film_serie_description"
                android:layout_width="@dimen/dimen_0dp"
                android:layout_height="wrap_content"
                tools:text="@tools:sample/lorem/random"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/detailFimsSeriesDescription"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>


</androidx.constraintlayout.widget.ConstraintLayout>