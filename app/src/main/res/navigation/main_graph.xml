<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_graph"
    app:startDestination="@+id/homeFragment">

    <!-- HOME FRAGMENT -->
    <fragment
        android:id="@+id/homeFragment"
        android:name="com.enriquepalmadev.appmarvel.ui.feature.home.view.HomeFragment"
        android:label="fragment_home"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_homeFragment_to_filmsAndSeriesFragment"
            app:destination="@id/filmSerieFragment" />
        <action
            android:id="@+id/action_homeFragment_to_comicsFragment"
            app:destination="@id/comicsFragment" />
        <action
            android:id="@+id/action_homeFragment_to_charactersFragment"
            app:destination="@id/charactersFragment" />

    </fragment>


    <!-- COMICS FRAGMENT -->
    <fragment
        android:id="@+id/comicsFragment"
        android:name="com.enriquepalmadev.appmarvel.ui.feature.comics.view.ComicsFragment"
        android:label="fragment_comics"
        tools:layout="@layout/fragment_comics" >
        <action
            android:id="@+id/action_comicsFragment_to_comicDetail"
            app:destination="@+id/comicDetail"
            app:enterAnim="@android:anim/fade_in"
            app:exitAnim="@android:anim/fade_out"
            app:popEnterAnim="@android:anim/fade_in"
            app:popExitAnim="@android:anim/fade_out" />
        <argument
            android:name="id"
            app:argType="integer" />
    </fragment>

    <!-- COMIC DETAIL FRAGMENT -->
    <fragment
        android:id="@+id/comicDetail"
        android:name="com.enriquepalmadev.appmarvel.ui.feature.comics.view.ComicDetailFragment"
        android:label="fragment_comic_detail"
        tools:layout="@layout/fragment_comic_detail" >
        <argument
            android:name="id"
            app:argType="integer" />
    </fragment>

    <!-- FILMS AND SERIES FRAGMENT -->
    <fragment
        android:id="@+id/filmSerieFragment"
        android:name="com.enriquepalmadev.appmarvel.ui.feature.series.view.FilmSerieFragment"
        android:label="fragment_series"
        tools:layout="@layout/fragment_films_series" >
        <action
            android:id="@+id/action_filmSerieFragment_to_itemDetailsFilmsSeriesFragment"
            app:destination="@id/itemDetailsFilmsSeriesFragment" />
    </fragment>

    <!-- ITEM DETAILS FILMS AND SERIES FRAGMENT -->
    <fragment
        android:id="@+id/itemDetailsFilmsSeriesFragment"
        android:name="com.enriquepalmadev.appmarvel.ui.feature.series.view.ItemDetailFilmSerieFragment"
        android:label="item_details_films_series_fragment"
        tools:layout="@layout/item_details_films_series" >
        <argument
            android:name="idSerie"
            app:argType="integer"
            android:defaultValue="0" />
    </fragment>

    <!-- CHARACTER FRAGMENT -->
    <fragment
        android:id="@+id/charactersFragment"
        android:name="com.enriquepalmadev.appmarvel.ui.feature.character.view.CharactersFragment"
        android:label="fragment_characters"
        tools:layout="@layout/fragment_characters" >
        <action
            android:id="@+id/action_charactersFragment_to_itemDetailsCharactersFragment"
            app:destination="@id/itemDetailsCharactersFragment" />
    </fragment>
    <fragment
        android:id="@+id/itemDetailsCharactersFragment"
        android:name="com.enriquepalmadev.appmarvel.ui.feature.character.view.CharacterDetailFragment"
        android:label="fragment_item_details_characters"
        tools:layout="@layout/fragment_item_details_characters" >
        <argument
            android:name="id"
            app:argType="integer" />
        <action
            android:id="@+id/action_itemDetailsCharactersFragment_to_charactersFragment"
            app:destination="@id/charactersFragment" />
    </fragment>
</navigation>