<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_graph"
    app:startDestination="@+id/homeFragment">

    <fragment
        android:id="@+id/comicsFragment"
        android:name="com.enriquepalmadev.appmarvel.ui.view.ComicsFragment"
        android:label="fragment_comics"
        tools:layout="@layout/fragment_comics" />
    <fragment
        android:id="@+id/filmsAndSeriesFragment"
        android:name="com.enriquepalmadev.appmarvel.ui.view.FilmsSeriesFragment"
        android:label="fragment_series"
        tools:layout="@layout/fragment_films_series" />
    <fragment
        android:id="@+id/homeFragment"
        android:name="com.enriquepalmadev.appmarvel.ui.view.HomeFragment"
        android:label="fragment_home"
        tools:layout="@layout/fragment_home" >
        <action
            android:id="@+id/action_homeFragment_to_filmsAndSeriesFragment"
            app:destination="@id/filmsAndSeriesFragment" />
        <action
            android:id="@+id/action_homeFragment_to_comicsFragment"
            app:destination="@id/comicsFragment" />
        <action
            android:id="@+id/action_homeFragment_to_charactersFragment"
            app:destination="@id/charactersFragment" />
    </fragment>
    <fragment
        android:id="@+id/charactersFragment"
        android:name="com.enriquepalmadev.appmarvel.ui.view.CharactersFragment"
        android:label="fragment_characters"
        tools:layout="@layout/fragment_characters" >
        <action
            android:id="@+id/action_charactersFragment_to_itemDetailsCharactersFragment"
            app:destination="@id/itemDetailsCharactersFragment" />
    </fragment>
    <fragment
        android:id="@+id/itemDetailsCharactersFragment"
        android:name="com.enriquepalmadev.appmarvel.ui.view.ItemDetailsCharactersFragment"
        android:label="fragment_item_details_characters"
        tools:layout="@layout/fragment_item_details_characters" />
</navigation>